{{- $pages := where .Site.RegularPages "Section" "posts" -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if and (gt $limit 0) (gt (len $pages) $limit) -}}
{{- $pages = first $limit $pages -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />{{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify | htmlEscape }}{{ if .Truncated }} [&#8230;]{{ end }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
